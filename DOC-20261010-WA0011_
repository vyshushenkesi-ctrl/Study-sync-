<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#635bdb">
<link rel="manifest" id="mf">
<link rel="icon" href="data:image/png;base64,">
<title>StudySync - Student Planner</title>
<style>
:root{--bg:#f3f4fb;--card:#fff;--ink:#252744;--main:#635bdb;--soft:#eeedff;--mute:#777;--line:#eee;--warn:#fff0d9;--warnink:#805000;--ok:#2e9e6b;--bad:#e55353}
@media (prefers-color-scheme:dark){:root{--bg:#171828;--card:#222440;--ink:#e8e9ff;--soft:#2e3052;--mute:#a0a2c4;--line:#33365a;--warn:#3d3220;--warnink:#ffd99a}}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:var(--ink)}
header{background:var(--main);color:#fff;padding:24px 18px;border-radius:0 0 24px 24px}
header h1{margin:0}header p{margin:4px 0 0}
.hud{max-width:800px;margin:14px auto 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pill{background:#ffffff26;padding:6px 12px;border-radius:20px;font-weight:bold;font-size:14px}
.xpbar{flex:1;min-width:140px;height:10px;background:#ffffff40;border-radius:6px;overflow:hidden}
.xpbar div{height:100%;width:0;background:#ffd35c;transition:width .4s}
.container{padding:18px;max-width:800px;margin:auto}
.card{background:var(--card);padding:18px;margin-bottom:18px;border-radius:16px;box-shadow:0 3px 12px #0000000c}
h2{font-size:19px;margin-top:0}
input,select,button{width:100%;padding:12px;margin:8px 0;border:1px solid var(--line);border-radius:9px;font-size:15px;background:var(--card);color:var(--ink)}
button{background:var(--main);color:#fff;border:none;cursor:pointer;font-weight:bold}
button:hover{opacity:.9}
button.alt{background:var(--soft);color:var(--main)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #ffb703;outline-offset:2px}
.row{display:flex;gap:8px}.row>*{flex:1}
.goal{padding:12px;margin:10px 0;border-radius:10px;background:var(--soft);display:flex;align-items:center;gap:10px}
.goal input[type=checkbox]{width:20px;height:20px;margin:0;flex:none}
.goal span{flex:1;overflow-wrap:anywhere}
.completed{text-decoration:line-through;opacity:.55}
.delete{width:auto;background:var(--bad);padding:8px 10px;margin:0}
.stats{display:flex;gap:10px}
.stat{flex:1;text-align:center;padding:14px 5px;border-radius:12px;background:var(--soft)}
.stat strong{display:block;font-size:25px;color:var(--main)}
.day{padding:10px;border-bottom:1px solid var(--line)}
#reminder{background:var(--warn);color:var(--warnink);padding:12px;border-radius:10px;display:none;margin-bottom:15px}
small{color:var(--mute)}
.timer{font-size:52px;font-weight:bold;text-align:center;margin:6px 0;font-variant-numeric:tabular-nums}
.orb{width:110px;height:110px;margin:10px auto;border-radius:50%;background:radial-gradient(circle,#a9a4ff,#635bdb);opacity:.55}
.orb.on{animation:breathe 8s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:scale(.8);opacity:.45}50%{transform:scale(1.1);opacity:.85}}
@media (prefers-reduced-motion:reduce){.orb.on{animation:none;opacity:.8}.xpbar div{transition:none}}
.center{text-align:center}
.opt{background:var(--soft);color:var(--ink);text-align:left;font-weight:normal}
.opt.right{background:#d7f5e6;color:#145a38}
.opt.wrong{background:#fde0e0;color:#8a1f1f}
.solution{background:var(--soft);padding:12px;border-radius:10px;margin:8px 0}
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.badge{padding:12px;border-radius:12px;background:var(--soft);text-align:center}
.badge.locked{opacity:.45;filter:grayscale(1)}
.badge b{display:block;font-size:28px}
.badge small{display:block}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#252744;color:#fff;padding:12px 18px;border-radius:24px;opacity:0;pointer-events:none;transition:opacity .3s;max-width:90%;text-align:center;z-index:9}
#toast.show{opacity:1}
[hidden]{display:none!important}
.toggle{display:flex;align-items:center;gap:10px;margin:8px 0;cursor:pointer}
.toggle input{width:22px;height:22px;margin:0;flex:none}
#focusMsg{color:var(--mute);font-size:14px}
.linkbtn{display:block;padding:12px;margin:8px 0;border-radius:9px;background:var(--main);color:#fff;text-align:center;font-weight:bold;text-decoration:none}
.linkbtn.em{background:var(--bad)}
#sosBtn{position:fixed;right:16px;bottom:16px;width:56px;height:56px;border-radius:50%;background:var(--bad);font-size:24px;padding:0;margin:0;z-index:20;box-shadow:0 4px 14px #0004}
#sos{position:fixed;left:0;right:0;bottom:0;max-width:800px;margin:auto;background:var(--card);padding:18px 18px 84px;border-radius:20px 20px 0 0;box-shadow:0 -6px 24px #0003;z-index:19;max-height:85vh;overflow:auto}
details{margin:8px 0}summary{cursor:pointer;font-weight:bold;padding:6px 0}
.perm{margin:8px 0;padding:10px;border-radius:10px;background:var(--soft);font-size:14px}
#notificationStatus{color:var(--mute);font-size:14px}
body.t1{zoom:1.15}body.t2{zoom:1.3}
html.hc{--bg:#000;--card:#000;--ink:#fff;--main:#ffd400;--soft:#1a1a1a;--mute:#e6e6e6;--line:#fff;--warn:#000;--warnink:#ffd400}
html.hc .card{border:2px solid #fff}
html.hc button,html.hc .linkbtn,html.hc header{color:#000}
html.hc button.alt{color:#ffd400;border:2px solid #ffd400}
html.hc .delete,html.hc .em,html.hc #sosBtn{color:#fff}
html.hc .pill{background:#00000026}
html.hc .stat strong{color:#ffd400}
.mini{font-size:13px;color:var(--mute)}
@media (max-width:450px){.stats{gap:5px}.stat strong{font-size:21px}.timer{font-size:44px}}
</style>
</head>
<body>

<header>
    <h1>📚 StudySync</h1>
    <p>Your goals. Your timetable. Your progress.</p>
    <div class="hud" aria-live="polite">
        <span class="pill" id="levelPill">Level 1</span>
        <span class="pill" id="xpPill">0 XP</span>
        <span class="pill" id="streakPill">🔥 0 day streak</span>
        <div class="xpbar" aria-label="XP progress to next level"><div id="xpFill"></div></div>
    </div>
</header>

<div class="container">

    <div id="reminder" role="status"></div>

    <section class="card">
        <h2>📊 My Progress</h2>
        <div class="stats">
            <div class="stat"><strong id="total">0</strong><small>Total Goals</small></div>
            <div class="stat"><strong id="done">0</strong><small>Completed</small></div>
            <div class="stat"><strong id="pending">0</strong><small>Pending</small></div>
        </div>
        <button class="alt" id="restBtn" onclick="useRest()">🛌 Use my weekly rest day (keeps my streak)</button>
        <p class="mini">One rest day per week. Rest is part of learning.</p>
    </section>

    <section class="card">
        <h2>🎯 Add a Daily Goal</h2>
        <input id="goalInput" type="text" placeholder="Example: Complete 5 C programs">
        <select id="goalDay" aria-label="Goal day"></select>
        <input id="deadline" type="date" aria-label="Goal deadline">
        <button onclick="addGoal()">+ Add Goal</button>
        <small>Finishing a goal earns 10 XP.</small>
        <div id="goals"></div>
    </section>

    <section class="card">
        <h2>🧭 Smart Focus Mode <small>(optional)</small></h2>
        <label class="toggle"><input type="checkbox" id="smartOn"><span>Turn on Smart Focus when I want it</span></label>
        <p><small>You pick the assignment and the time. StudySync adds gentle reminders: a halfway check-in, a 5-minute heads-up and a short break at the end. Nothing is blocked, and you can exit any time.</small></p>
        <div id="smartBox" hidden>
            <select id="energy" aria-label="How is your energy right now">
                <option value="">How's your energy? (optional, not saved)</option>
                <option value="low">Low</option><option value="ok">Okay</option><option value="high">Good</option>
            </select>
            <select id="focusTask" aria-label="Assignment to work on"></select>
            <input id="focusCustom" type="text" maxlength="60" placeholder="Or type what you'll work on">
            <select id="focusLen" aria-label="Focus duration">
                <option value="15">15 minutes</option>
                <option value="25" selected>25 minutes</option>
                <option value="45">45 minutes</option>
                <option value="60">60 minutes</option>
            </select>
            <label class="toggle"><input type="checkbox" id="keepAwake"><span>Keep my screen on during the session</span></label>
            <div class="orb" id="orb"></div>
            <div class="timer" id="timer" aria-live="off">25:00</div>
            <p class="center" id="focusMsg">Choose what you'll work on, then start when you're ready.</p>
            <div class="row">
                <button id="focusStart" onclick="focusToggle()">Start</button>
                <button class="alt" onclick="exitFocus()">Exit focus</button>
            </div>
            <div class="row">
                <button class="alt" onclick="phoneTimer()">⏱ Phone timer</button>
                <button class="alt" onclick="focusToCalendar()">📅 Add to calendar</button>
            </div>
            <p><small>These use your phone's own clock or calendar, so the alert still arrives when StudySync is closed. Support varies by phone.</small></p>
        </div>
        <div id="nudge" class="solution" hidden></div>
    </section>

    <section class="card">
        <h2>⚡ Daily Challenge</h2>
        <p id="challengeText"></p>
        <p><small id="challengeHint"></small></p>
        <button id="challengeBtn" onclick="completeChallenge()">Mark challenge done (+25 XP)</button>
    </section>

    <section class="card">
        <h2>🧠 Quick Quiz</h2>
        <div id="quizBox">
            <p>Answer 5 questions. Every answer shows a solution. Each correct answer earns 5 XP, and a perfect score adds a 10 XP bonus.</p>
            <p><small id="quizStats"></small></p>
            <button onclick="startQuiz()">Start quiz</button>
        </div>
    </section>

    <section class="card">
        <h2>📘 Weekly Syllabus Quiz</h2>
        <p><small>Log what you completed this week, then quiz yourself on it. Add your own question and short answer for the best quiz. Topics from this and last week are kept, and older ones are cleared automatically unless they are scheduled for review. Missed topics come back after 1, 3, 7 and 14 days.</small></p>
        <input id="sylTopic" type="text" maxlength="80" placeholder="Topic completed (e.g. Pointers in C)">
        <input id="sylQ" type="text" maxlength="140" placeholder="Your quiz question (optional)">
        <input id="sylA" type="text" maxlength="100" placeholder="Short answer (optional)">
        <button onclick="addSyl()">+ Add completed topic</button>
        <button class="alt" onclick="importGoals()">Add my completed goals as topics</button>
        <div id="sylList"></div>
        <div id="sylQuiz"></div>
        <button id="sylStart" onclick="startSyl()">Start weekly quiz</button>
    </section>

    <section class="card">
        <h2>📅 Weekly Timetable</h2>
        <input id="subject" type="text" placeholder="Subject or activity">
        <select id="studyDay" aria-label="Study day"></select>
        <input id="studyTime" type="time" aria-label="Study time">
        <button onclick="addSchedule()">+ Add Study Session</button>
        <button class="alt" onclick="scheduleToCalendar()">📅 Add timetable to calendar (.ics)</button>
        <div id="schedule"></div>
    </section>

    <section class="card">
        <h2>🏅 Achievements</h2>
        <div class="badges" id="badges"></div>
    </section>

    <section class="card">
        <h2>🗓 Exam Countdown</h2>
        <input id="examSubject" type="text" maxlength="40" placeholder="Subject or exam">
        <input id="examDate" type="date" aria-label="Exam date">
        <button onclick="addExam()">+ Add exam</button>
        <div id="examList"></div>
    </section>

    <section class="card">
        <h2>📈 Weekly Review</h2>
        <p><small>A kind look back at your week. Best on Sunday.</small></p>
        <button onclick="showReview()">Show my week</button>
        <div id="reviewBox"></div>
    </section>

    <section class="card">
        <h2>💾 Backup &amp; Sharing</h2>
        <p><small>Your data lives only on this device, so save a backup now and then. The backup file includes your emergency numbers, so keep it private. Quiz sets contain only topics, questions and answers, so they are safe to share with classmates.</small></p>
        <button onclick="exportBackup()">Save backup file</button>
        <button class="alt" onclick="exportQuizSet()">Share my quiz set (file)</button>
        <label for="importFile"><small>Import a backup or a classmate's quiz set</small></label>
        <input id="importFile" type="file" accept=".json,application/json">
    </section>

    <section class="card">
        <h2>♿ Accessibility</h2>
        <label for="textSize"><small>Text size</small></label>
        <select id="textSize"><option value="0">Normal</option><option value="1">Large</option><option value="2">Extra large</option></select>
        <label class="toggle"><input type="checkbox" id="hcMode"><span>High-contrast theme</span></label>
    </section>

    <section class="card">
        <h2>🔔 Reminder Settings</h2>
        <p>Get a reminder for unfinished goals and when a timetable session starts (while this page is open).</p>
        <button onclick="checkGoals()">Check My Pending Goals</button>
        <label for="notifMode"><small>Notification reminders (default: Off)</small></label>
        <select id="notifMode">
            <option value="off">Off</option>
            <option value="end">End only</option>
            <option value="all">All 4 reminders</option>
        </select>
        <p><small>All 4 means: timetable start, halfway, 5 minutes left and finish. They are silent, use generic wording and only appear while StudySync is in the background.</small></p>
        <button onclick="requestNotifications()">Enable Browser Notifications</button>
        <p id="notificationStatus"></p>
        <p id="iosTip" class="perm" hidden>📱 On iPhone, tap Share → Add to Home Screen to get notifications. Until then, reminders appear inside the page and you can use Add to calendar.</p>
        <details>
            <summary>What StudySync asks for, and why</summary>
            <div class="perm"><strong>🔔 Notifications (optional).</strong> Used only for gentle reminders: session start, halfway, 5 minutes left and finish. Asked only when you tap "Enable Browser Notifications". If you say no, reminders still appear inside the page.</div>
            <div class="perm"><strong>💡 Keep screen on (no permission prompt).</strong> Only if you tick the box in Smart Focus. It is released the moment the session ends.</div>
            <div class="perm"><strong>📞 Emergency buttons.</strong> StudySync never reads your calls, contacts or phone state. The buttons just hand a number to your dialer.</div>
            <div class="perm"><strong>🚫 Never requested:</strong> location, camera, microphone, contacts, storage or phone access. StudySync does not block calls, apps or other notifications.</div>
            <div class="perm"><strong>🌐 Hosting and install.</strong> Notifications and installing need HTTPS. Host the file free on GitHub Pages or Netlify, then in Chrome tap ⋮ → Add to Home screen so it opens like an app.</div>
            <div class="perm"><strong>🔒 Your data.</strong> Goals, timetable, XP, streak, badges and your weekly syllabus topics stay on this device (topics are cleared automatically once their review schedule ends). Assignment names typed for focus are not saved. No account, no tracking, nothing is sent anywhere.</div>
        </details>
        <button id="installBtn" class="alt" hidden>📲 Install StudySync</button>
        <button class="alt" onclick="resetAll()">Reset all data</button>
    </section>

</div>
<button id="sosBtn" aria-label="Emergency and essentials" onclick="toggleSOS()">🆘</button>
<div id="sos" role="dialog" aria-label="Emergency and essentials" hidden>
    <h2>Emergency &amp; essentials</h2>
    <p><small>Always available, even during focus. These buttons open your phone's dialer or messages, and you press call or send yourself.</small></p>
    <button class="alt" onclick="exitFocus(true);toggleSOS()">Pause focus now</button>
    <a id="callEm" class="linkbtn em" href="tel:112">📞 Call emergency number</a>
    <a id="callContact" class="linkbtn" href="#" hidden>📞 Call my trusted contact</a>
    <a id="smsContact" class="linkbtn" href="#" hidden>💬 Message my trusted contact</a>
    <details>
        <summary>Set my numbers (kept only on this device)</summary>
        <input id="emNum" type="tel" inputmode="tel" placeholder="Local emergency number (default 112)">
        <input id="contactNum" type="tel" inputmode="tel" placeholder="Trusted contact number (optional)">
        <button onclick="saveNumbers()">Save numbers</button>
    </details>
    <button class="alt" onclick="toggleSOS()">Close</button>
</div>
<div id="toast" role="status"></div>

<script>
const DAYS = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const WEEK = DAYS.slice(1).concat("Sunday");
const KEY = "studysyncV2";
const DEF = {goals:[],schedule:[],xp:0,streak:0,lastActive:"",badges:[],challengeDone:"",challengeCount:0,
             focusSessions:0,nmode:"off",syl:[],weeklyQuizzes:0,exams:[],freezeWeek:"",freezeDay:"",quizTaken:0,perfect:0,notified:{}};

function load() {
    try {
        const saved = JSON.parse(localStorage.getItem(KEY));
        if (saved) return Object.assign({}, DEF, saved);
    } catch (e) {}
    const s = Object.assign({}, DEF);
    try {  // migrate data from the first version
        s.goals = JSON.parse(localStorage.getItem("studysyncGoals") || "[]");
        s.schedule = JSON.parse(localStorage.getItem("studysyncSchedule") || "[]");
    } catch (e) {}
    return s;
}
let S = load();
function saveData() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) {} }
const $ = id => document.getElementById(id);

function fmt(d) {
    return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
}
const today = () => fmt(new Date());

let toastTimer;
function toast(msg) {
    const t = $("toast"); t.textContent = msg; t.classList.add("show");
    clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}

/* ---------- XP, streaks, badges ---------- */
const BADGES = [
    {id:"first",  icon:"🌱", name:"First Step",     desc:"Complete 1 goal",       ok:()=>S.goals.filter(g=>g.completed).length>=1},
    {id:"five",   icon:"✅", name:"Goal Getter",    desc:"Complete 5 goals",      ok:()=>S.goals.filter(g=>g.completed).length>=5},
    {id:"planner",icon:"🗓️", name:"Planner",        desc:"Add 5 timetable sessions", ok:()=>S.schedule.length>=5},
    {id:"s3",     icon:"🔥", name:"On a Roll",      desc:"3 day streak",          ok:()=>S.streak>=3},
    {id:"s7",     icon:"🌟", name:"Week Warrior",   desc:"7 day streak",          ok:()=>S.streak>=7},
    {id:"f1",     icon:"🌿", name:"Calm Focus",     desc:"Finish 1 focus session",ok:()=>S.focusSessions>=1},
    {id:"f5",     icon:"🧘", name:"Deep Worker",    desc:"Finish 5 focus sessions",ok:()=>S.focusSessions>=5},
    {id:"chal",   icon:"⚡", name:"Challenger",     desc:"Do a daily challenge",  ok:()=>S.challengeCount>=1},
    {id:"quiz",   icon:"🧠", name:"Quiz Taker",     desc:"Finish a quiz",         ok:()=>S.quizTaken>=1},
    {id:"wk",    icon:"📘", name:"Weekly Reviewer", desc:"Finish a weekly syllabus quiz", ok:()=>S.weeklyQuizzes>=1},
    {id:"ace",    icon:"🏆", name:"Quiz Ace",       desc:"Score 5/5 on a quiz",   ok:()=>S.perfect>=1},
    {id:"l3",     icon:"🚀", name:"Level 3",        desc:"Reach level 3",         ok:()=>level()>=3}
];
const level = () => Math.floor(S.xp / 100) + 1;

function touchStreak() {
    const t = today();
    if (S.lastActive === t) return;
    const y = dayAgo(1), y2 = dayAgo(2);
    S.streak = (S.lastActive === y || (S.freezeDay === y && S.lastActive === y2)) ? S.streak + 1 : 1;
    S.lastActive = t;
}
function addXP(n, msg) {
    if (n <= 0) return;
    const before = level();
    S.xp += n;
    touchStreak();
    toast("+" + n + " XP" + (msg ? " · " + msg : "") + (level() > before ? " · Level up! 🎉" : ""));
    checkBadges();
    saveData(); renderHud();
}
function checkBadges() {
    BADGES.forEach(b => {
        if (!S.badges.includes(b.id) && b.ok()) {
            S.badges.push(b.id);
            setTimeout(() => toast("Badge unlocked: " + b.icon + " " + b.name), 1400);
        }
    });
    renderBadges();
}
function renderHud() {
    $("levelPill").textContent = "Level " + level();
    $("xpPill").textContent = S.xp + " XP";
    // streak only counts if it was active today or yesterday
    const live = liveStreak(), rested = S.freezeWeek === weekKey(0);
    $("restBtn").textContent = rested ? "🌙 Rest day used this week" : "🛌 Use my weekly rest day (keeps my streak)";
    $("restBtn").disabled = rested;
    const bar = $("xpFill").parentElement; bar.setAttribute("role", "progressbar"); bar.setAttribute("aria-valuenow", S.xp % 100);
    $("streakPill").textContent = "🔥 " + live + " day streak";
    $("xpFill").style.width = (S.xp % 100) + "%";
}
function renderBadges() {
    const box = $("badges"); box.innerHTML = "";
    BADGES.forEach(b => {
        const d = document.createElement("div");
        d.className = "badge" + (S.badges.includes(b.id) ? "" : " locked");
        const i = document.createElement("b"); i.textContent = b.icon;
        const n = document.createElement("strong"); n.textContent = b.name;
        const s = document.createElement("small"); s.textContent = b.desc;
        d.append(i, n, s); box.appendChild(d);
    });
}

/* ---------- Goals ---------- */
function fillDays() {
    ["goalDay","studyDay"].forEach(id => {
        WEEK.forEach(d => { const o = document.createElement("option"); o.textContent = d; $(id).appendChild(o); });
        $(id).value = DAYS[new Date().getDay()];
    });
}
function addGoal() {
    const text = $("goalInput").value.trim();
    if (!text) { alert("Please enter a study goal!"); return; }
    S.goals.push({id:Date.now(), text, day:$("goalDay").value, deadline:$("deadline").value,
                  completed:false, rewarded:false});
    $("goalInput").value = "";
    saveData(); renderGoals();
}
function toggleGoal(id) {
    const g = S.goals.find(x => x.id === id);
    if (!g) return;
    g.completed = !g.completed; g.doneWeek = g.completed ? weekKey(0) : "";
    let reward = false;
    if (g.completed && !g.rewarded) { g.rewarded = true; reward = true; }
    saveData(); renderGoals();
    if (reward) addXP(10, "goal complete"); else checkBadges();
}
function deleteGoal(id) { S.goals = S.goals.filter(g => g.id !== id); saveData(); renderGoals(); }

function renderGoals() {
    const c = $("goals"); c.innerHTML = "";
    if (!S.goals.length) c.innerHTML = "<p>No goals added yet. Add your first one above.</p>";
    S.goals.forEach(goal => {
        const item = document.createElement("div"); item.className = "goal";
        const cb = document.createElement("input"); cb.type = "checkbox"; cb.checked = goal.completed;
        cb.setAttribute("aria-label", "Mark goal completed");
        cb.addEventListener("change", () => toggleGoal(goal.id));
        const label = document.createElement("span");
        label.className = goal.completed ? "completed" : "";
        label.textContent = goal.text + " — " + goal.day + (goal.deadline ? " (Due: " + goal.deadline + ")" : "");
        const rm = document.createElement("button"); rm.className = "delete"; rm.textContent = "Delete";
        rm.addEventListener("click", () => deleteGoal(goal.id));
        item.append(cb, label, rm); c.appendChild(item);
    });
