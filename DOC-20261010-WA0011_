    if (!S.syl.length) { toast("Add a topic first."); return; }
    const answers = [...new Set(S.syl.filter(x => x.a).map(x => x.a))];
    const shuffle = a => a.slice().sort(() => Math.random() - .5);
    const cards = shuffle(S.syl).sort((a, b) => dueNow(b) - dueNow(a)).slice(0, 10).map(x => {
        const q = x.q || "Explain \"" + x.topic + "\" in your own words.";
        const others = shuffle(answers.filter(a => a !== x.a)).slice(0, 3);
        if (x.a && others.length >= 3) {
            const opts = shuffle(others.concat(x.a));
            return {id:x.id, q, topic:x.topic, mode:"mc", opts, ans:opts.indexOf(x.a), sol:x.a};
        }
        return {id:x.id, q, topic:x.topic, mode:"self", sol:x.a || "Check your notes for: " + x.topic};
