let bTimer = null;
function showBreak() {
    const n = $("nudge"); n.textContent = "";
    n.appendChild(mk("p", "Break idea: " + BREAKS[Math.floor(Math.random() * BREAKS.length)]));
    const b = mk("button", "Start 5-minute break timer"), skip = mk("button", "Skip", "alt");
    b.addEventListener("click", () => {
        b.disabled = true; clearInterval(bTimer); const end = Date.now() + 300000;
        bTimer = setInterval(() => {
            const left = Math.ceil((end - Date.now()) / 1000);
            if (left <= 0) { clearInterval(bTimer); n.hidden = true; gentle("Break over. Ready when you are.", "Break over. Ready when you are.", "end"); }
            else b.textContent = "Break: " + mmss(left);
        }, 500);
    });
    skip.addEventListener("click", () => { clearInterval(bTimer); n.hidden = true; });
    n.append(b, skip); n.hidden = false;
}

/* ---------- Backup, import and quiz-set sharing ---------- */
function saveFile(text, name) {
    const url = URL.createObjectURL(new Blob([text], {type:"application/json"}));
    const a = mk("a"); a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
}
function exportBackup() { saveFile(JSON.stringify(S), "studysync-backup.json"); toast("Backup saved. Keep it somewhere safe."); }
function exportQuizSet() {
    const items = S.syl.filter(x => x.q && x.a).map(x => ({topic:x.topic, q:x.q, a:x.a}));
    if (!items.length) { toast("Add topics with a question and answer first."); return; }
    saveFile(JSON.stringify({type:"studysync-quiz", items}), "studysync-quiz-set.json"); toast("Quiz set saved. Send the file to a classmate.");
}
const cut = (v, n) => String(v == null ? "" : v).slice(0, n);
function importData(d) {
    if (d && d.type === "studysync-quiz" && Array.isArray(d.items)) {
        pruneSyl(); const have = new Set(S.syl.map(x => x.topic.toLowerCase())); let n = 0;
        d.items.slice(0, 50).forEach((it, i) => {
            const topic = cut(it && it.topic, 80).trim();
            if (topic && !have.has(topic.toLowerCase())) { S.syl.push({id:Date.now() + i, topic, q:cut(it.q, 140), a:cut(it.a, 100), week:weekKey(0)}); have.add(topic.toLowerCase()); n++; }
        });
        saveData(); renderSyl(); toast("Added " + n + " topic(s) from the quiz set."); return;
    }
    if (d && Array.isArray(d.goals) && Array.isArray(d.schedule)) {
        if (!confirm("Replace everything in StudySync with this backup?")) return;
        d.goals = d.goals.filter(g => g && typeof g.text === "string");
        d.schedule = d.schedule.filter(x => x && ["subject", "day", "time"].every(f => typeof x[f] === "string"));
        d.syl = (d.syl || []).filter(x => x && typeof x.topic === "string");
        d.exams = (d.exams || []).filter(x => x && typeof x.subject === "string" && typeof x.date === "string");
        S = Object.assign({}, DEF, d); saveData(); renderAll(); toast("Backup restored."); return;
    }
    toast("That isn't a StudySync file.");
}
$("importFile").addEventListener("change", e => {
    const f = e.target.files[0]; if (!f) return;
    if (f.size > 1e6) { toast("That file is too large."); e.target.value = ""; return; }
    const r = new FileReader();
    r.onload = () => { try { importData(JSON.parse(r.result)); } catch (err) { toast("Couldn't read that file."); } e.target.value = ""; };
    r.readAsText(f);
});

/* ---------- Accessibility ---------- */
function applyUI() {
    const u = S.ui || {t:0, hc:false};
    document.body.classList.remove("t1", "t2"); if (u.t) document.body.classList.add("t" + u.t);
    document.documentElement.classList.toggle("hc", !!u.hc);
    $("textSize").value = String(u.t || 0); $("hcMode").checked = !!u.hc;
}
$("textSize").addEventListener("change", () => { S.ui = Object.assign({}, S.ui, {t:+$("textSize").value}); saveData(); applyUI(); });
$("hcMode").addEventListener("change", () => { S.ui = Object.assign({}, S.ui, {hc:$("hcMode").checked}); saveData(); applyUI(); });

/* ---------- Install as an app (needs HTTPS hosting) ---------- */
let deferredInstall = null;
window.addEventListener("beforeinstallprompt", e => { e.preventDefault(); deferredInstall = e; $("installBtn").hidden = false; });
$("installBtn").addEventListener("click", async () => {
    if (!deferredInstall) return;
    deferredInstall.prompt(); try { await deferredInstall.userChoice; } catch (e) {}
    deferredInstall = null; $("installBtn").hidden = true;
});
/* The app manifest is built here so everything stays in this one file. */
(function () {
    if (!location.protocol.startsWith("http")) return;
    try {
        const icon = (n, d) => ({src:"data:image/png;base64," + d, sizes:n + "x" + n, type:"image/png", purpose:"any maskable"});
        const m = {name:"StudySync", short_name:"StudySync", start_url:location.href.split("#")[0], display:"standalone",
                   background_color:"#f3f4fb", theme_color:"#635bdb",
                   icons:[icon(192, ""), icon(512, "")]};
        $("mf").href = URL.createObjectURL(new Blob([JSON.stringify(m)], {type:"application/manifest+json"}));
    } catch (e) {}
})();

/* ---------- Emergency & essentials ---------- */
function toggleSOS(){ const el=$("sos"); el.hidden=!el.hidden; if(!el.hidden) renderSOS(); }
function cleanNum(v){ return String(v).replace(/[^\d+*#]/g,"").slice(0,20); }
function renderSOS(){
    const em=S.emNum||"112", c=S.contact||"";
    $("callEm").href="tel:"+em; $("callEm").textContent="📞 Call emergency number ("+em+")";
    $("callContact").hidden=$("smsContact").hidden=!c;
    if(c){ $("callContact").href="tel:"+c; $("smsContact").href="sms:"+c; }
    $("emNum").value=S.emNum||""; $("contactNum").value=c;
}
function saveNumbers(){
    const e=cleanNum($("emNum").value), c=cleanNum($("contactNum").value);
    if(e) S.emNum=e; else delete S.emNum;
    if(c) S.contact=c; else delete S.contact;
    saveData(); renderSOS(); toast("Saved on this device only");
}
document.addEventListener("keydown",e=>{ if(e.key==="Escape") $("sos").hidden=true; });

/* ---------- Daily challenge ---------- */
const CHALLENGES = [
    ["Finish one 25-minute focus session on your hardest subject.", "Hint: Smart Focus above can time it for you."],
    ["Write 3 flashcards for something you studied this week.", "Hint: put the question on one side and the answer on the other."],
    ["Solve 2 practice problems without looking at your notes.", "Hint: check your answers after, and note any you missed."],
    ["Explain one concept out loud in 2 minutes, as if teaching a friend.", "Hint: if you get stuck, that is the gap to study next."],
    ["Review yesterday's notes for 10 minutes.", "Hint: re-read, then close the notes and write what you remember."],
    ["Plan your top 3 goals for tomorrow.", "Hint: make each goal small enough to finish in one sitting."],
    ["Take a 10-minute walk, then complete one small task.", "Hint: rest is part of studying well."]
];
function dayIndex() { const d = new Date(); return Math.floor(new Date(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5) % CHALLENGES.length; }
function renderChallenge() {
    const c = CHALLENGES[dayIndex()];
    $("challengeText").textContent = c[0]; $("challengeHint").textContent = c[1];
    const done = S.challengeDone === today();
    $("challengeBtn").disabled = done;
    $("challengeBtn").textContent = done ? "Completed today ✓" : "Mark challenge done (+25 XP)";
}
function completeChallenge() {
    if (S.challengeDone === today()) return;
    S.challengeDone = today(); S.challengeCount++;
    renderChallenge(); addXP(25, "daily challenge");
}

/* ---------- Quiz with solutions ---------- */
const BANK = [
    {q:"Which C function prints formatted text to the screen?", o:["scanf","printf","malloc","return"], a:1, e:"printf() writes formatted output. scanf() reads input, malloc() allocates memory."},
    {q:"What does int x = 5 / 2; store in x in C?", o:["2.5","3","2","0"], a:2, e:"Both operands are integers, so C uses integer division and drops the fraction: 5 / 2 = 2."},
    {q:"In C, the first element of an array has which index?", o:["0","1","-1","It depends"], a:0, e:"C arrays are zero-indexed. arr[0] is the first element."},
    {q:"Which operator checks equality in C?", o:["=","==","=>","!="], a:1, e:"== compares values. A single = assigns a value."},
    {q:"Which loop always runs its body at least once?", o:["for","while","do-while","if"], a:2, e:"do-while checks its condition after the body, so the body runs once before the first check."},
    {q:"What does strlen(\"study\") return?", o:["4","5","6","It depends"], a:1, e:"\"study\" has 5 characters. strlen() does not count the null terminator."},
    {q:"What is active recall?", o:["Re-reading notes","Highlighting text","Testing yourself without looking","Listening to music"], a:2, e:"Retrieving information from memory strengthens it far more than passive re-reading."},
    {q:"What is spaced repetition?", o:["Cramming the night before","Reviewing at increasing intervals","Studying one topic all day","Reading once"], a:1, e:"Reviewing just as you begin to forget, with longer gaps each time, builds long-term memory."},
    {q:"In the Pomodoro technique, a typical work block is?", o:["5 minutes","25 minutes","90 minutes","3 hours"], a:1, e:"Pomodoro uses about 25 minutes of focus followed by a short break of around 5 minutes."},
    {q:"Which habit best helps memory consolidation?", o:["All-nighters","Good sleep","Extra caffeine","Skipping meals"], a:1, e:"Sleep is when the brain consolidates what you learned during the day."}
];
let QZ = null;
function startQuiz() {
    const pool = BANK.slice().sort(() => Math.random() - .5).slice(0, 5);
    QZ = {pool, i:0, score:0, answered:false};
    showQ();
}
function showQ() {
    const box = $("quizBox"); box.innerHTML = "";
    const q = QZ.pool[QZ.i]; QZ.answered = false;
    const head = document.createElement("p"); head.innerHTML = "<small>Question " + (QZ.i+1) + " of " + QZ.pool.length + "</small>";
    const text = document.createElement("p"); text.innerHTML = "<strong></strong>"; text.firstChild.textContent = q.q;
    box.append(head, text);
    const btns = q.o.map((opt, idx) => {
        const b = document.createElement("button"); b.className = "opt"; b.textContent = opt;
        b.addEventListener("click", () => answerQ(idx, btns, q)); box.appendChild(b); return b;
    });
    const sol = document.createElement("div"); sol.id = "sol"; box.appendChild(sol);
}
function answerQ(idx, btns, q) {
    if (QZ.answered) return; QZ.answered = true;
    btns.forEach((b, i) => { b.disabled = true; if (i === q.a) b.classList.add("right"); else if (i === idx) b.classList.add("wrong"); });
    if (idx === q.a) QZ.score++;
    const sol = $("sol"); sol.className = "solution";
    sol.textContent = (idx === q.a ? "✅ Correct. " : "❌ Not quite. ") + "Solution: " + q.e;
    const next = document.createElement("button");
    next.textContent = QZ.i + 1 < QZ.pool.length ? "Next question" : "See results";
    next.addEventListener("click", () => { QZ.i++; QZ.i < QZ.pool.length ? showQ() : endQuiz(); });
    $("quizBox").appendChild(next);
}
function endQuiz() {
    const n = QZ.pool.length, sc = QZ.score, perfect = sc === n;
    S.quizTaken++; wkBump("quiz"); if (perfect) S.perfect++;
    S.quizBest = Math.max(S.quizBest || 0, sc);
    const box = $("quizBox"); box.innerHTML = "";
    const p = document.createElement("p");
    p.textContent = "You scored " + sc + " / " + n + ". " + (perfect ? "Perfect! 🏆" : sc >= 3 ? "Nice work!" : "Every attempt helps. Review the solutions and try again.");
    const b = document.createElement("button"); b.textContent = "Play again"; b.addEventListener("click", startQuiz);
    box.append(p, b);
    addXP(sc * 5 + (perfect ? 10 : 0), "quiz");
    quizStats();
}
function quizStats() {
    const el = $("quizStats"); if (el) el.textContent = S.quizTaken ? "Quizzes taken: " + S.quizTaken + " · Best score: " + (S.quizBest || 0) + "/5" : "";
}

/* ---------- Reset ---------- */
function resetAll() {
    if (!confirm("Delete all goals, sessions, XP and badges? This cannot be undone.")) return;
    S = Object.assign({}, DEF, {goals:[], schedule:[], badges:[], notified:{}, syl:[], exams:[]});
    saveData(); renderAll(); toast("All data cleared");
}

function renderAll() { renderGoals(); renderSchedule(); renderChallenge(); renderBadges(); renderHud(); quizStats(); fillTasks(); renderSyl(); renderExams(); applyUI(); $("notifMode").value = S.nmode || "off"; notifStatus(); }
fillDays(); renderAll(); sessionReminders();
document.querySelectorAll("input[placeholder]:not([aria-label])").forEach(i => i.setAttribute("aria-label", i.placeholder));
